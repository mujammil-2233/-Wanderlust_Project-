<% layout('layouts/boilerplate') %>

    <div class="page animate-enter">
        <div class="favorites-container">
            <h2>My Favorite Listings</h2>

            <% if (favorites && favorites.length> 0) { %>
                <div class="listings-grid">
                    <% favorites.forEach(listing=> { %>
                        <div class="card">
                            <img src="<%= listing.image %>" alt="<%= listing.title %>" class="card-img-top" />
                            <div class="card-body">
                                <h5 class="card-title">
                                    <%= listing.title %>
                                </h5>
                                <p class="card-text text-muted">
                                    <small>
                                        <%= listing.location || 'Location not specified' %>
                                    </small>
                                </p>
                                <p class="card-text">
                                    <%= listing.description.substring(0, 60) %>...
                                </p>
                                <% if (listing.price) { %>
                                    <p class="card-text"><strong>$<%= listing.price %>/night</strong></p>
                                    <% } %>
                                        <a href="/listings/<%= listing._id %>" class="btn btn-primary">View</a>
                                        <button onclick="removeFavorite('<%= listing._id %>')"
                                            class="btn btn-danger">Remove</button>
                            </div>
                        </div>
                        <% }); %>
                </div>
                <% } else { %>
                    <div class="alert alert-info">
                        <p>You haven't added any favorites yet. <a href="/listings">Browse listings</a></p>
                    </div>
                    <% } %>
        </div>
    </div>

    <script>
        function removeFavorite(listingId) {
            if (confirm('Remove from favorites?')) {
                fetch(`/api/favorites/${listingId}`, { method: 'DELETE' })
                    .then(r => r.json())
                    .then(d => {
                        if (d.ok) {
                            window.location.reload();
                        } else {
                            alert('Error removing favorite');
                        }
                    });
            }
        }
    </script>

    <style>
        .favorites-container {
            max-width: 1100px;
            margin: 0 auto;
        }

        .listings-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 1.25rem;
        }
    </style>